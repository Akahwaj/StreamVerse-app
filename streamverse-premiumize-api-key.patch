+package com.nuvio.tv.core.debrid
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class DebridProviderAuthenticationTest {
+
+    @Test
+    fun `torbox keeps device-code authorization`() {
+        assertEquals(DebridProviderAuthMethod.DeviceCode, DebridProviders.Torbox.authMethod)
+    }
+
+    @Test
+    fun `premiumize uses locally validated API key authorization`() {
+        assertEquals(DebridProviderAuthMethod.ApiKey, DebridProviders.Premiumize.authMethod)
+    }
+}
