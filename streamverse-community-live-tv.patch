-    if (!response.ok) throw new Error('Community directory HTTP ' + response.status);
-    var payload = await response.json();
-    renderCommunityAddons(payload && payload.addons);
+    var page = 1;
+    var allItems = [];
+    var hasNextPage = true;
+    while (hasNextPage) {
+      var endpoint = COMMUNITY_ADDONS_API + '/addons?limit=100&page=' + page + '&sort_by=stars&order=desc&nsfw=exclude';
+      if (query) endpoint += '&search=' + encodeURIComponent(query);
+      var response = await fetchWithTimeout(endpoint, { headers: { 'Accept': 'application/json' } }, 15000);
+      if (!response.ok) throw new Error('Community directory HTTP ' + response.status);
+      var payload = await response.json();
+      allItems = allItems.concat(Array.isArray(payload && payload.addons) ? payload.addons : []);
+      hasNextPage = !!(payload && payload.pagination && payload.pagination.hasNextPage);
+      page += 1;
+      if (page > 50) hasNextPage = false;
+    }
+
+    var communityItems = flattenCommunityAddons(allItems);
+    if (mode === 'live-tv') communityItems = communityItems.filter(isLiveTvCommunityAddon);
+    renderCommunityAddons(communityItems);
