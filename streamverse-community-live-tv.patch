+package com.nuvio.tv.ui.screens.livetv
+
+import com.nuvio.tv.domain.model.Addon
+import com.nuvio.tv.domain.model.CatalogDescriptor
+import com.nuvio.tv.domain.model.ContentType
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class LiveTvCatalogTest {
+    private fun addon(name: String, catalog: CatalogDescriptor) = Addon(
+        id = "test",
+        name = name,
+        version = "1.0.0",
+        description = null,
+        logo = null,
+        baseUrl = "https://example.com",
+        catalogs = listOf(catalog),
+        types = listOf(catalog.type),
+        resources = emptyList()
+    )
+
+    @Test
+    fun channelCatalogIsAlwaysLiveTv() {
+        val catalog = CatalogDescriptor(ContentType.CHANNEL, "channel", "channels", "Channels")
+        assertTrue(isLiveTvCatalog(addon("Example", catalog), catalog))
+    }
+
+    @Test
+    fun tvSeriesCatalogIsNotMistakenForLiveTv() {
+        val catalog = CatalogDescriptor(ContentType.TV, "tv", "popular", "Popular TV Shows")
+        assertFalse(isLiveTvCatalog(addon("Metadata", catalog), catalog))
+    }
+
+    @Test
+    fun iptvCatalogIsLiveTv() {
+        val catalog = CatalogDescriptor(ContentType.TV, "tv", "iptv-us", "US Live TV")
+        assertTrue(isLiveTvCatalog(addon("IPTV", catalog), catalog))
+    }
+}
