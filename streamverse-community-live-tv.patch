+function flattenCommunityAddons(items) {
+  var result = [];
+  var seen = {};
+  (Array.isArray(items) ? items : []).forEach(function(item) {
+    [item].concat(Array.isArray(item && item.instances) ? item.instances : []).forEach(function(candidate) {
+      var url = safeCommunityHttpsUrl(candidate && candidate.manifestUrl);
+      if (!url || seen[url]) return;
+      seen[url] = true;
+      result.push(candidate);
+    });
+  });
+  return result;
+}
+
+function isLiveTvCommunityAddon(item) {
+  var manifest = item && item.manifest ? item.manifest : {};
+  var catalogs = Array.isArray(manifest.catalogs) ? manifest.catalogs : [];
+  if (catalogs.some(function(catalog) {
+    return String(catalog && catalog.type || '').toLowerCase() === 'channel';
+  })) return true;
+
+  var searchable = [
+    manifest.name,
+    manifest.description,
+    item && item.slug
+  ].concat(
+    (Array.isArray(item && item.categories) ? item.categories : []).map(function(category) {
+      return category && category.name;
+    })
+  ).concat(
+    catalogs.map(function(catalog) {
+      return [catalog && catalog.id, catalog && catalog.name, catalog && catalog.type].join(' ');
+    })
+  ).filter(Boolean).join(' ').toLowerCase();
+
+  var hasLiveMarker = /(^|\W)(live\s*tv|iptv|m3u|television|tv\s*channels?|channels?)(\W|$)/i.test(searchable);
+  var hasTvCatalog = catalogs.some(function(catalog) {
+    var type = String(catalog && catalog.type || '').toLowerCase();
+    return type === 'tv' || type === 'channel';
+  });
+  return hasLiveMarker && (hasTvCatalog || catalogs.length > 0);
+}
