+
+internal fun isLiveTvCatalog(addon: Addon, catalog: CatalogDescriptor): Boolean {
+    val type = catalog.apiType.trim().lowercase()
+    if (type == "channel") return true
+    val searchable = listOf(addon.displayName, addon.name, addon.description, catalog.id, catalog.name)
+        .filterNotNull()
+        .joinToString(" ")
+        .lowercase()
+    val hasLiveMarker = listOf("live tv", "livetv", "iptv", "m3u", "television", "channel")
+        .any(searchable::contains)
+    return hasLiveMarker && type in setOf("tv", "channel", "unknown")
+}
+
+@HiltViewModel
+class LiveTvViewModel @Inject constructor(
+    addonRepository: AddonRepository
+) : ViewModel() {
+    val catalogs = addonRepository.getInstalledAddons()
+        .map { addons ->
+            addons.asSequence()
+                .filter { it.enabled }
+                .flatMap { addon ->
+                    addon.catalogs.asSequence()
+                        .filter { catalog -> isLiveTvCatalog(addon, catalog) }
+                        .map { catalog ->
+                            LiveTvCatalogEntry(
+                                addonId = addon.id,
+                                addonName = addon.displayName,
+                                catalogId = catalog.id,
+                                catalogName = catalog.name,
+                                type = catalog.apiType
+                            )
+                        }
+                }
+                .distinctBy { "${it.addonId}:${it.type}:${it.catalogId}" }
+                .toList()
+        }
+        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), emptyList())
+}
