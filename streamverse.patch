+function safeCommunityHttpsUrl(value) {
+  try {
+    var parsed = new URL(String(value || ''));
+    return parsed.protocol === 'https:' ? parsed.toString() : null;
+  } catch (_) {
+    return null;
+  }
+}
+
+function encodeCommunityArgument(value) {
+  return encodeURIComponent(value).replace(/'/g, '%27');
+}
+
+function setCommunityStatus(message, isError) {
+  var status = document.getElementById('communityStatus');
+  if (!status) return;
+  status.textContent = message || '';
+  status.style.display = message ? 'block' : 'none';
+  status.style.color = isError ? '#CF6679' : 'rgba(255, 255, 255, 0.55)';
+}
+
+function renderCommunityAddons(items) {
+  var list = document.getElementById('communityAddonList');
+  if (!list) return;
+  list.innerHTML = '';
+  if (!Array.isArray(items) || items.length === 0) {
+    setCommunityStatus('${context.getString(R.string.web_community_empty).replace("'", "\\'")}', false);
+    return;
+  }
+
+  setCommunityStatus('', false);
+  items.forEach(function(item) {
+    var manifest = item && item.manifest ? item.manifest : {};
+    var manifestUrl = safeCommunityHttpsUrl(item && item.manifestUrl);
+    if (!manifestUrl) return;
+    var configureUrl = safeCommunityHttpsUrl(item && item.configureUrl);
+    var behaviorHints = manifest && manifest.behaviorHints ? manifest.behaviorHints : {};
+    var configurationRequired = behaviorHints.configurationRequired === true;
+    var resources = Array.isArray(manifest.resources) ? manifest.resources : [];
+    var catalogOnly = resources.length > 0 && resources.every(function(resource) {
+      return resource === 'catalog' || (resource && resource.name === 'catalog');
+    });
+    var categories = Array.isArray(item.categories)
+      ? item.categories.map(function(category) { return category && category.name; }).filter(Boolean).slice(0, 5)
+      : [];
+    var encodedManifest = encodeCommunityArgument(manifestUrl);
+    var encodedConfigure = configureUrl ? encodeCommunityArgument(configureUrl) : '';
+    var li = document.createElement('li');
+    li.className = 'addon-item';
+    li.innerHTML =
+      '<div class="addon-info">' +
+        '<div class="addon-name">' + escapeHtml(manifest.name || item.slug || manifestUrl) +
+          (catalogOnly ? ' <span class="badge-community">${context.getString(R.string.web_community_catalog_only).replace("'", "\\'")}</span>' : '') +
+          (configurationRequired ? ' <span class="badge-community">${context.getString(R.string.web_community_configuration_required).replace("'", "\\'")}</span>' : '') +
+        '</div>' +
+        '<div class="addon-desc">' + escapeHtml(manifest.description || '') + '</div>' +
+        '<div class="community-categories">' + escapeHtml(categories.join(' · ')) + '</div>' +
+      '</div>' +
+      '<div class="addon-actions">' +
+        (configureUrl ? '<button class="btn btn-toggle" type="button" onclick="openCommunityConfigure(\'' + encodedConfigure + '\')">${context.getString(R.string.web_community_configure).replace("'", "\\'")}</button>' : '') +
+        (!configurationRequired ? '<button class="btn" type="button" onclick="installCommunityAddon(\'' + encodedManifest + '\')">${context.getString(R.string.web_community_add_default).replace("'", "\\'")}</button>' : '') +
+      '</div>';
+    list.appendChild(li);
+  });
+}
+
+async function loadCommunityAddons() {
+  var input = document.getElementById('communitySearch');
