+  setCommunityStatus('${context.getString(R.string.web_community_loading).replace("'", "\\'")}', false);
+  try {
+    var endpoint = COMMUNITY_ADDONS_API + '/addons?limit=25&sort_by=stars&order=desc&nsfw=exclude';
+    if (query) endpoint += '&search=' + encodeURIComponent(query);
+    var response = await fetchWithTimeout(endpoint, { headers: { 'Accept': 'application/json' } }, 10000);
+    if (!response.ok) throw new Error('Community directory HTTP ' + response.status);
+    var payload = await response.json();
+    renderCommunityAddons(payload && payload.addons);
+  } catch (_) {
