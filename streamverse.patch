+  if (!input) return;
+  input.value = manifestUrl;
+  addAddon();
+}
+
+function openCommunityConfigure(encodedConfigureUrl) {
+  var configureUrl = safeCommunityHttpsUrl(decodeURIComponent(encodedConfigureUrl || ''));
+  if (!configureUrl) return;
+  window.open(configureUrl, '_blank', 'noopener,noreferrer');
