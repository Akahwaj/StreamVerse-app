+    private fun streamIdentityKey(stream: Stream): String {
+        val directUrl = stream.getStreamUrl()?.trim()?.lowercase()
+        if (!directUrl.isNullOrEmpty()) return "url:$directUrl"
+
+        val infoHash = stream.getEffectiveInfoHash()?.trim()?.lowercase()
+        if (!infoHash.isNullOrEmpty()) {
+            return "torrent:$infoHash:${stream.getEffectiveFileIdx() ?: -1}"
+        }
+
+        return "fallback:${stream.stableKey()}"
+    }
+
+    private fun rankCandidateStreams(streams: List<Stream>): List<Stream> =
+        streams.asSequence()
+            .filter(::isPlayable)
+            .distinctBy(::streamIdentityKey)
+            .sortedWith(
+                compareByDescending<Stream> { it.isDirectDebrid() }
+                    .thenByDescending { it.getStreamUrl() != null }
+                    .thenByDescending { it.debridCacheStatus?.state == StreamDebridCacheState.CACHED }
+                    .thenByDescending { it.qualityValue }
+            )
+            .toList()
+
 
 
