+++ b/app/src/main/java/com/nuvio/tv/core/player/StreamFailureHistory.kt
@@ -0,0 +1,54 @@
+package com.nuvio.tv.core.player
+
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Short-lived source quarantine used by automatic source selection.
+ *
+ * A source that fails playback is suppressed for a bounded cooldown so the next
+ * selection/failover does not immediately choose the same broken URL again.
+ * Successful first-frame playback clears the failure entry. The history is
+ * intentionally process-local: uninstall/reinstall and normal process reset do
+ * not create a hidden persistence path.
+ */
+object StreamFailureHistory {
+    private const val FAILURE_COOLDOWN_MS = 10L * 60L * 1000L
+    private const val MAX_ENTRIES = 256
+
+    private val recentFailure = ConcurrentHashMap<String, Long>()
+
+    private fun key(url: String?): String? =
+        url?.trim()?.takeIf { it.isNotEmpty() }?.lowercase()
+
+    fun recordFailure(url: String?, nowMs: Long = System.currentTimeMillis()) {
+        val sourceKey = key(url) ?: return
+        prune(nowMs)
+        if (recentFailure.size >= MAX_ENTRIES && sourceKey !in recentFailure) {
+            recentFailure.entries.minByOrNull { it.value }?.key?.let(recentFailure::remove)
+        }
+        recentFailure[sourceKey] = nowMs
+    }
+
+    fun recordSuccess(url: String?) {
+        key(url)?.let(recentFailure::remove)
+    }
+
+    fun isSuppressed(url: String?, nowMs: Long = System.currentTimeMillis()): Boolean {
+        val sourceKey = key(url) ?: return false
+        val failedAt = recentFailure[sourceKey] ?: return false
+        if (nowMs - failedAt >= FAILURE_COOLDOWN_MS) {
+            recentFailure.remove(sourceKey, failedAt)
+            return false
+        }
+        return true
+    }
+
+    private fun prune(nowMs: Long) {
+        recentFailure.entries.removeIf { nowMs - it.value >= FAILURE_COOLDOWN_MS }
+    }
+}

