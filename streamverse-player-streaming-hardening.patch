diff --git a/app/src/main/java/com/nuvio/tv/core/backup/StreamVerseBackupManager.kt b/app/src/main/java/com/nuvio/tv/core/backup/StreamVerseBackupManager.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/core/backup/StreamVerseBackupManager.kt
@@ -0,0 +1,190 @@
+package com.nuvio.tv.core.backup
+
+import android.content.Context
+import java.io.BufferedInputStream
+import java.io.BufferedOutputStream
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.File
+import java.io.InputStream
+import java.io.OutputStream
+import java.security.SecureRandom
+import java.util.zip.ZipEntry
+import java.util.zip.ZipInputStream
+import java.util.zip.ZipOutputStream
+import javax.crypto.Cipher
+import javax.crypto.CipherInputStream
+import javax.crypto.CipherOutputStream
+import javax.crypto.SecretKeyFactory
+import javax.crypto.spec.GCMParameterSpec
+import javax.crypto.spec.PBEKeySpec
+import javax.crypto.spec.SecretKeySpec
+
+/** User-initiated, portable StreamVerse backup archive. */
+object StreamVerseBackupManager {
+    const val SCHEMA_VERSION = 1
+    private const val PBKDF2_ITERATIONS = 210_000
+    private const val KEY_BITS = 256
+    private val MAGIC = byteArrayOf('S'.code.toByte(), 'V'.code.toByte(), 'B'.code.toByte(), 'K'.code.toByte(), '1'.code.toByte())
+    private val random = SecureRandom()
+
+    fun createBackup(context: Context, output: OutputStream, passphrase: CharArray) {
+        require(passphrase.size >= 6) { "Backup passphrase must contain at least 6 characters" }
+        val salt = ByteArray(16).also(random::nextBytes)
+        val iv = ByteArray(12).also(random::nextBytes)
+        val key = deriveKey(passphrase, salt)
+        val cipher = Cipher.getInstance("AES/GCM/NoPadding").apply {
+            init(Cipher.ENCRYPT_MODE, key, GCMParameterSpec(128, iv))
+        }
+
+        val buffered = BufferedOutputStream(output)
+        DataOutputStream(buffered).apply {
+            write(MAGIC)
+            writeInt(SCHEMA_VERSION)
+            writeInt(salt.size)
+            write(salt)
+            writeInt(iv.size)
+            write(iv)
+            flush()
+        }
+
+        ZipOutputStream(CipherOutputStream(buffered, cipher)).use { zip ->
+            backupRoots(context).forEach { (prefix, root) ->
+                if (root.exists()) addTree(zip, root, prefix, root)
+            }
+            zip.finish()
+        }
+    }
+
+    fun restoreBackup(context: Context, input: InputStream, passphrase: CharArray) {
+        require(passphrase.size >= 6) { "Backup passphrase must contain at least 6 characters" }
+        val buffered = BufferedInputStream(input)
+        val header = DataInputStream(buffered)
+        val magic = ByteArray(MAGIC.size).also(header::readFully)
+        require(magic.contentEquals(MAGIC)) { "Not a StreamVerse backup" }
+        val backupVersion = header.readInt()
+        require(backupVersion in 1..SCHEMA_VERSION) { "Unsupported backup format version: $backupVersion" }
+        val saltSize = header.readInt()
+        require(saltSize in 8..64) { "Invalid backup salt" }
+        val salt = ByteArray(saltSize).also(header::readFully)
+        val ivSize = header.readInt()
+        require(ivSize in 12..16) { "Invalid backup IV" }
+        val iv = ByteArray(ivSize).also(header::readFully)
+
+        val key = deriveKey(passphrase, salt)
+        val cipher = Cipher.getInstance("AES/GCM/NoPadding").apply {
+            init(Cipher.DECRYPT_MODE, key, GCMParameterSpec(128, iv))
+        }
+
+        ZipInputStream(CipherInputStream(buffered, cipher)).use { zip ->
+            var entry = zip.nextEntry
+            while (entry != null) {
+                if (!entry.isDirectory) restoreEntry(context, zip, entry)
+                zip.closeEntry()
+                entry = zip.nextEntry
+            }
+        }
+    }
+
+    private fun deriveKey(passphrase: CharArray, salt: ByteArray): SecretKeySpec {
+        val spec = PBEKeySpec(passphrase, salt, PBKDF2_ITERATIONS, KEY_BITS)
+        return try {
+            val bytes = SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256").generateSecret(spec).encoded
+            SecretKeySpec(bytes, "AES")
+        } finally {
+            spec.clearPassword()
+        }
+    }
+
+    private fun backupRoots(context: Context): List<Pair<String, File>> {
+        val data = File(context.applicationInfo.dataDir)
+        return listOf(
+            "shared_prefs" to File(data, "shared_prefs"),
+            "databases" to File(data, "databases"),
+            "files" to context.filesDir
+        )
+    }
+
+    private fun addTree(zip: ZipOutputStream, file: File, prefix: String, root: File) {
+        if (file.isDirectory) {
+            file.listFiles()?.sortedBy { it.name }?.forEach { addTree(zip, it, prefix, root) }
+            return
+        }
+        if (!file.isFile) return
+        val relative = file.relativeTo(root).invariantSeparatorsPath
+        if (relative.contains("..")) return
+        zip.putNextEntry(ZipEntry("$prefix/$relative"))
+        file.inputStream().buffered().use { it.copyTo(zip) }
+        zip.closeEntry()
+    }
+
+    private fun restoreEntry(context: Context, zip: ZipInputStream, entry: ZipEntry) {
+        val normalized = entry.name.replace('\\', '/')
+        require(!normalized.startsWith('/') && !normalized.split('/').contains("..")) { "Unsafe backup entry" }
+        val slash = normalized.indexOf('/')
+        require(slash > 0 && slash < normalized.lastIndex) { "Invalid backup entry" }
+        val prefix = normalized.substring(0, slash)
+        val relative = normalized.substring(slash + 1)
+        val data = File(context.applicationInfo.dataDir)
+        val root = when (prefix) {
+            "shared_prefs" -> File(data, "shared_prefs")
+            "databases" -> File(data, "databases")
+            "files" -> context.filesDir
+            else -> throw IllegalArgumentException("Unsupported backup domain")
+        }
+        val target = File(root, relative)
+        val canonicalRoot = root.canonicalFile
+        val canonicalTarget = target.canonicalFile
+        require(canonicalTarget.path.startsWith(canonicalRoot.path + File.separator)) { "Unsafe restore path" }
+        canonicalTarget.parentFile?.mkdirs()
+        val temp = File(canonicalTarget.parentFile, canonicalTarget.name + ".restore.tmp")
+        temp.outputStream().buffered().use { zip.copyTo(it) }
+        if (canonicalTarget.exists() && !canonicalTarget.delete()) {
+            temp.delete()
+            throw IllegalStateException("Unable to replace ${canonicalTarget.name}")
+        }
+        if (!temp.renameTo(canonicalTarget)) {
+            temp.inputStream().use { source -> canonicalTarget.outputStream().use(source::copyTo) }
+            temp.delete()
+        }
+    }
+}

diff --git a/app/src/main/java/com/nuvio/tv/MainActivity.kt b/app/src/main/java/com/nuvio/tv/MainActivity.kt
--- a/app/src/main/java/com/nuvio/tv/MainActivity.kt
