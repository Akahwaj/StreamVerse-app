@@ -291,6 +291,93 @@ class MainActivity : ComponentActivity() {
         externalPlaybackTracker.onActivityResult(result)
     }
+
+    private var pendingBackupPassphrase: CharArray? = null
+    private var pendingRestorePassphrase: CharArray? = null
+
+    private val streamVerseBackupLauncher = registerForActivityResult(
+        androidx.activity.result.contract.ActivityResultContracts.CreateDocument("application/octet-stream")
+    ) { uri ->
+        val passphrase = pendingBackupPassphrase
+        pendingBackupPassphrase = null
+        if (uri == null || passphrase == null) {
+            passphrase?.fill('\u0000')
+            return@registerForActivityResult
+        }
+        lifecycleScope.launch(kotlinx.coroutines.Dispatchers.IO) {
+            val result = runCatching {
+                contentResolver.openOutputStream(uri, "w")?.use { output ->
+                    com.nuvio.tv.core.backup.StreamVerseBackupManager.createBackup(this@MainActivity, output, passphrase)
+                } ?: error("Unable to open backup destination")
+            }
+            passphrase.fill('\u0000')
+            kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.Main) {
+                Toast.makeText(this@MainActivity, result.fold({ "StreamVerse backup saved." }, { "Backup failed: ${it.message}" }), Toast.LENGTH_LONG).show()
+            }
+        }
+    }
+
+    private val streamVerseRestoreLauncher = registerForActivityResult(
+        androidx.activity.result.contract.ActivityResultContracts.OpenDocument()
+    ) { uri ->
+        val passphrase = pendingRestorePassphrase
+        pendingRestorePassphrase = null
+        if (uri == null || passphrase == null) {
+            passphrase?.fill('\u0000')
+            return@registerForActivityResult
+        }
+        lifecycleScope.launch(kotlinx.coroutines.Dispatchers.IO) {
+            val result = runCatching {
+                contentResolver.openInputStream(uri)?.use { input ->
+                    com.nuvio.tv.core.backup.StreamVerseBackupManager.restoreBackup(this@MainActivity, input, passphrase)
+                } ?: error("Unable to open backup file")
+            }
+            passphrase.fill('\u0000')
+            kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.Main) {
+                if (result.isSuccess) {
+                    Toast.makeText(this@MainActivity, "Restore complete. StreamVerse will close; reopen it to load restored data.", Toast.LENGTH_LONG).show()
+                    window.decorView.postDelayed({
+                        finishAffinity()
+                        android.os.Process.killProcess(android.os.Process.myPid())
+                    }, 1200L)
+                } else {
+                    Toast.makeText(this@MainActivity, "Restore failed: ${result.exceptionOrNull()?.message}", Toast.LENGTH_LONG).show()
+                }
+            }
+        }
+    }
+
+    private fun requestBackupPassphrase(title: String, onAccepted: (CharArray) -> Unit) {
+        val input = android.widget.EditText(this).apply {
+            inputType = android.text.InputType.TYPE_CLASS_TEXT or android.text.InputType.TYPE_TEXT_VARIATION_PASSWORD
+            hint = "At least 6 characters"
+            isSingleLine = true
+        }
+        android.app.AlertDialog.Builder(this)
+            .setTitle(title)
+            .setMessage("This passphrase encrypts the portable backup. You will need the same passphrase to restore it after reinstalling StreamVerse.")
+            .setView(input)
+            .setPositiveButton("Continue") { _, _ ->
+                val chars = input.text?.toString().orEmpty().toCharArray()
+                if (chars.size < 6) {
+                    chars.fill('\u0000')
+                    Toast.makeText(this, "Passphrase must contain at least 6 characters.", Toast.LENGTH_LONG).show()
+                } else {
+                    onAccepted(chars)
+                }
+            }
+            .setNegativeButton("Cancel", null)
+            .show()
+    }
+
+    fun exportBackup() = requestBackupPassphrase("Backup StreamVerse") { passphrase ->
+        pendingBackupPassphrase = passphrase
+        streamVerseBackupLauncher.launch("StreamVerse-backup-${System.currentTimeMillis()}.svbk")
+    }
+
+    fun importBackup() = requestBackupPassphrase("Restore StreamVerse") { passphrase ->
+        pendingRestorePassphrase = passphrase
+        streamVerseRestoreLauncher.launch(arrayOf("application/octet-stream", "application/zip", "*/*"))
+    }
 
