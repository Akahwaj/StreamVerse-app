   var query = input ? input.value.trim() : '';
   setCommunityStatus('${context.getString(R.string.web_community_loading).replace("'", "\\'")}', false);
   try {
@@ -2085,7 +2091,8 @@ async function loadCommunityAddons(mode) {
     var allItems = [];
     var hasNextPage = true;
     while (hasNextPage) {
-      var endpoint = COMMUNITY_ADDONS_API + '/addons?limit=100&page=' + page + '&sort_by=stars&order=desc&nsfw=exclude';
+      var nsfwQuery = effectiveMode === 'adult' ? '&nsfw=only' : '&nsfw=exclude';
+      var endpoint = COMMUNITY_ADDONS_API + '/addons?limit=100&page=' + page + '&sort_by=stars&order=desc' + nsfwQuery;
       if (query) endpoint += '&search=' + encodeURIComponent(query);
       var response = await fetchWithTimeout(endpoint, { headers: { 'Accept': 'application/json' } }, 15000);
       if (!response.ok) throw new Error('Community directory HTTP ' + response.status);
@@ -2097,7 +2104,7 @@ async function loadCommunityAddons(mode) {
     }
 
     var communityItems = flattenCommunityAddons(allItems);
-    if (mode === 'live-tv') communityItems = communityItems.filter(isLiveTvCommunityAddon);
+    if (effectiveMode === 'live-tv') communityItems = communityItems.filter(isLiveTvCommunityAddon);
     renderCommunityAddons(communityItems);
     if (communityItems.length > 0) {
       setCommunityStatus(
@@ -2111,6 +2118,53 @@ async function loadCommunityAddons(mode) {
   }
 }
 
+async function hashAdultPin(pin) {
+  if (!window.crypto || !window.crypto.subtle || !window.TextEncoder) return null;
+  var bytes = new TextEncoder().encode('StreamVerse-Adult-PIN-v1:' + pin);
+  var digest = await window.crypto.subtle.digest('SHA-256', bytes);
+  return Array.from(new Uint8Array(digest)).map(function(value) {
+    return value.toString(16).padStart(2, '0');
+  }).join('');
+}
+
+async function loadAdultCommunityAddons() {
+  if (sessionStorage.getItem('streamverseAdultUnlocked') === 'true') {
+    loadCommunityAddons('adult');
+    return;
+  }
+
+  var savedHash = localStorage.getItem('streamverseAdultPinHash');
+  if (!savedHash) {
+    var newPin = window.prompt('${context.getString(R.string.web_community_adult_pin_set).replace("'", "\\'")}');
+    if (newPin === null) return;
+    if (!/^[0-9]{4}$/.test(newPin)) {
+      window.alert('${context.getString(R.string.web_community_adult_pin_invalid).replace("'", "\\'")}');
+      return;
+    }
+    var confirmPin = window.prompt('${context.getString(R.string.web_community_adult_pin_confirm).replace("'", "\\'")}');
+    if (confirmPin !== newPin) {
+      window.alert('${context.getString(R.string.web_community_adult_pin_mismatch).replace("'", "\\'")}');
+      return;
+    }
+    savedHash = await hashAdultPin(newPin);
+    if (!savedHash) {
+      window.alert('${context.getString(R.string.web_community_adult_pin_unavailable).replace("'", "\\'")}');
+      return;
+    }
+    localStorage.setItem('streamverseAdultPinHash', savedHash);
+  }
+
+  var enteredPin = window.prompt('${context.getString(R.string.web_community_adult_pin_enter).replace("'", "\\'")}');
+  if (enteredPin === null) return;
+  var enteredHash = await hashAdultPin(enteredPin);
+  if (!enteredHash || enteredHash !== savedHash) {
+    window.alert('${context.getString(R.string.web_community_adult_pin_incorrect).replace("'", "\\'")}');
+    return;
+  }
+  sessionStorage.setItem('streamverseAdultUnlocked', 'true');
+  loadCommunityAddons('adult');
+}
+
 function installCommunityAddon(encodedManifestUrl) {
   var manifestUrl = safeCommunityHttpsUrl(decodeURIComponent(encodedManifestUrl || ''));
   if (!manifestUrl) return;
