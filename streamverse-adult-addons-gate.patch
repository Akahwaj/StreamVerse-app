@@ -1207,6 +1208,7 @@ var pollStartTime = 0;
 var POLL_TIMEOUT = 120000;
 var POLL_INTERVAL = 1500;
 var COMMUNITY_ADDONS_API = 'https://stremio-addons.net/api/v0';
+var communityMode = 'all';
 
 var i18n = {
   newCollection: '${context.getString(R.string.collections_new).replace("'", "\\'")}',
@@ -2077,7 +2079,11 @@ function renderCommunityAddons(items) {
 
 async function loadCommunityAddons(mode) {
   var input = document.getElementById('communitySearch');
-  if (input && (mode === 'all' || mode === 'live-tv')) input.value = '';
